{
  "name": "Lean 4 + TeX",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4", "James-Yu.latex-workshop"],
      "settings": {
        "latex-workshop.latex.recipes": [
          { "name": "latexmk", "tools": ["latexmk"] }
        ],
        "latex-workshop.latex.tools": [
          {
            "name": "latexmk",
            "command": "latexmk",
            "args": ["%DOC%"],
            "env": {}
          }
        ],
        "latex-workshop.latex.outDir": "%DIR%/build"
      }
    }
  }
}
